    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.system_error_logs (execution_id, workflow_id, workflow_name, failed_node, error_message, execution_url, failed_at) VALUES ($1, $2, $3, $4, $5, $6, $7::timestamptz) RETURNING id;",
        "options": {
          "queryReplacement": "={{ [$json.execution_id, $json.workflow_id, $json.workflow_name, $json.failed_node, $json.error_message, $json.execution_url, $json.failed_at] }}"
