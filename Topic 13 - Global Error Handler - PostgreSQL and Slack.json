        "jsCode": "const data=$input.first().json||{};const e=data.execution||{};const w=data.workflow||{};const err=e.error||data.error||{};return [{json:{execution_id:String(e.id||''),workflow_id:String(w.id||''),workflow_name:String(w.name||'Unknown workflow'),failed_node:String(e.lastNodeExecuted||err.node?.name||'Unknown node'),error_message:String(err.message||err.description||'Unspecified error').slice(0,4000),execution_url:String(e.url||''),failed_at:new Date().toISOString()}}];"
